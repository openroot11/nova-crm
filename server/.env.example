# La base de datos es un archivo local (server/data/nova_crm.db, se crea
# solo) -- no hace falta configurar ninguna conexion.

# Puerto donde corre el servidor local (opcional, 4000 por defecto).
# PORT=4000

# Desactiva el login por completo (cualquiera con la URL entra como admin,
# sin usuario ni contraseña). Solo para desarrollo/demo, nunca en uso real.
# NOVA_DISABLE_AUTH=true

# ============================================================
#  Conexion a Odoo (opcional): crear leads con deduplicacion de
#  contactos + armar cotizaciones (lineas, IVA, total, PDF).
#  Si se deja en blanco, el CRM funciona igual pero sin esas funciones.
# ============================================================
# ODOO_URL=https://tuempresa.odoo.com
# ODOO_DB=nombre_de_la_base
# ODOO_USER=usuario@correo.com
# ODOO_PASSWORD=la_contraseña
# ODOO_API_KEY=clave_api        # alternativa a ODOO_PASSWORD

# Cada cuántos segundos el CRM revisa Odoo y copia el estado del embudo
# (Asignado/Contactado/Cotizado/Perdido) de la oportunidad al lead.
# 30 por defecto; 0 = desactivar esa sincronización Odoo -> CRM.
# ODOO_SYNC_SECONDS=30

# Nombre de la etapa del pipeline de Odoo que corresponde a cada paso del
# embudo de Nova CRM. Cámbialos si tu Odoo usa otros nombres (ej. New /
# Qualified / Proposition, o nombres propios). La etapa "ganada" se detecta
# sola por el marcador is_won, no hace falta configurarla.
# Para ver los nombres reales de tu Odoo:  node scripts/odoo-setup.js --check
# ODOO_STAGE_ASSIGNED=Asignado
# ODOO_STAGE_CONTACTED=Contactado
# ODOO_STAGE_QUOTED=Cotizado
# ODOO_STAGE_WON=Ganado
