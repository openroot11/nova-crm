# La base de datos es un archivo local (server/data/nova_crm.db, se crea
# solo) -- no hace falta configurar ninguna conexion.

# Puerto donde corre el servidor local (opcional, 4000 por defecto).
# PORT=4000

# Desactiva el login por completo (cualquiera con la URL entra como admin,
# sin usuario ni contraseña). Solo para desarrollo/demo, nunca en uso real.
# NOVA_DISABLE_AUTH=true

# ============================================================
#  Conexion a Odoo (opcional): crear leads con deduplicacion de
#  contactos + armar cotizaciones (lineas, IVA, total, PDF).
#  Si se deja en blanco, el CRM funciona igual pero sin esas funciones.
# ============================================================
# ODOO_URL=https://tuempresa.odoo.com
# ODOO_DB=nombre_de_la_base
# ODOO_USER=usuario@correo.com
# ODOO_PASSWORD=la_contraseña
# ODOO_API_KEY=clave_api        # alternativa a ODOO_PASSWORD

# Cada cuántos segundos el CRM revisa Odoo y copia el estado del embudo
# (Asignado/Contactado/Cotizado/Perdido) de la oportunidad al lead.
# 30 por defecto; 0 = desactivar esa sincronización Odoo -> CRM.
# ODOO_SYNC_SECONDS=30

# Etapas del pipeline de Odoo que anclan el embudo de Nova CRM. Cámbialas si
# tu Odoo usa otros nombres. Cualquier oportunidad en una etapa >= la de
# "cotizado" (y que no sea ganada/perdida) cuenta como cotizada en el CRM.
# "Ganado" se detecta por is_won. ODOO_STAGE_LOST puede ser una lista (comas).
# Para ver los nombres reales de tu Odoo:  node scripts/odoo-setup.js --check
# ODOO_STAGE_ASSIGNED=Asignado
# ODOO_STAGE_CONTACTED=Contactado
# ODOO_STAGE_QUOTED=Cotizado
# ODOO_STAGE_WON=Ganado
# ODOO_STAGE_LOST=Perdido

# ============================================================
#  Conexion a Google Ads (opcional): trae el gasto por campaña
#  automáticamente (reemplaza la captura manual en Estadísticas) y permite
#  reportar ventas cerradas como conversión. Si se deja en blanco, el CRM
#  funciona igual pero la inversión se sigue registrando a mano.
#  Ver docs/GOOGLE_ADS_SETUP.md para cómo obtener cada valor.
# ============================================================
# GOOGLE_ADS_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_ADS_CLIENT_SECRET=xxxx
# GOOGLE_ADS_REFRESH_TOKEN=xxxx
# GOOGLE_ADS_DEVELOPER_TOKEN=xxxx
# GOOGLE_ADS_CUSTOMER_ID=1234567890            # solo dígitos, sin guiones
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=1234567890      # opcional: solo si se entra vía una cuenta administradora (MCC)
# GOOGLE_ADS_CONVERSION_ACTION_ID=              # opcional: solo para reportar ventas cerradas como conversión

# Cada cuántas horas el CRM trae el gasto/campañas de Google Ads.
# 6 por defecto; 0 = desactivar esa sincronización.
# GOOGLE_ADS_SYNC_HOURS=6
