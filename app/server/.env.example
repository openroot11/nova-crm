# Cadena de conexion a Postgres de Supabase (Project Settings -> Database ->
# Connection string -> "Direct connection", puerto 5432). Copia este archivo
# a ".env" (sin ".example") y pega la cadena real ahi -- .env nunca se sube
# a git.
DATABASE_URL=postgresql://postgres:TU-PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# Puerto donde corre el servidor local (opcional, 4000 por defecto).
# PORT=4000
